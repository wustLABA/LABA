#!/bin/sh
# ============================================================================
# LABA 自动部署 hook
#
# 作用：在执行 `git push` 且推送目标包含 main 时，自动构建前端并把产物
#       发布到 gh-pages 分支 —— 也就是 https://jolaaa999.github.io/LABA/ 的
#       实际来源分支，从而让线上站点自动更新。
#
# 停用：删除本文件，或执行 git config --unset core.hooksPath
# 本文件是权威版本，经 core.hooksPath 启用（见 README「## 部署」）：
#   git config core.hooksPath .githooks
# 添加时间：2026-09-17
# ============================================================================

# 阻止 hook 内部发起的 push 递归触发自身
if [ -n "$LABA_DEPLOY_ACTIVE" ]; then
  exit 0
fi

REMOTE_NAME="${1:-origin}"
REMOTE_URL="$(git remote get-url "$REMOTE_NAME" 2>/dev/null || echo "$REMOTE_NAME")"

# 只在本次推送包含 main 时生效
TARGET_MAIN=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] && TARGET_MAIN=1
done
[ "$TARGET_MAIN" = "1" ] || exit 0

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0

# git 调用 hook 时会带上 GIT_DIR 等仓库级环境变量，它们优先于 `-C`，
# 会让下面所有 `git -C <临时目录>` 的操作落回当前仓库（表现为
# "remote origin already exists"，更糟的情况是切换当前仓库的分支）。
# 必须先清掉，后续一律用 -C 显式指定目录。
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR GIT_PREFIX

# 本地必须领先或等于远端 main，否则说明本地代码落后（还没 pull），
# 此时部署会把旧版本推上线 —— 直接跳过。
git fetch --no-tags --quiet "$REMOTE_URL" main 2>/dev/null
REMOTE_MAIN="$(git rev-parse --verify FETCH_HEAD 2>/dev/null)"
if [ -n "$REMOTE_MAIN" ] && ! git merge-base --is-ancestor "$REMOTE_MAIN" HEAD 2>/dev/null; then
  echo "[deploy] 本地分支落后于远端 main（请先 git pull），已跳过部署。"
  exit 0
fi

# 若仓库已存在 GitHub Actions 工作流，交给 Actions 处理，避免重复部署
if [ -f "$ROOT/.github/workflows/deploy-pages.yml" ]; then
  echo "[deploy] 已启用 GitHub Actions 工作流，跳过本地部署。"
  exit 0
fi

WEB="$ROOT/web"
[ -d "$WEB" ] || exit 0

# 包管理器一律使用 pnpm：本机 npm/npx 已损坏（npm-prefix.js 缺失），
# 调用 npm 会直接抛 MODULE_NOT_FOUND。pnpm 为本仓库约定的唯一包管理器。
# 优先 pnpm，回退 corepack，最后才退回 npm（供环境未装 pnpm 的协作者）。
PKG_MGR=""
if command -v pnpm >/dev/null 2>&1; then
  PKG_MGR="pnpm"
elif command -v corepack >/dev/null 2>&1; then
  PKG_MGR="corepack pnpm"
elif command -v npm >/dev/null 2>&1; then
  PKG_MGR="npm"
else
  echo "[deploy] 未找到 pnpm / corepack / npm，跳过本地部署。"
  exit 0
fi

if [ ! -d "$WEB/node_modules" ]; then
  echo "[deploy] 跳过：web/node_modules 不存在（先执行 cd web && pnpm install）。"
  exit 0
fi

echo "[deploy] 检测到推送到 main，正在使用 $PKG_MGR 构建前端…（不影响本次推送结果）"
if ! ( cd "$WEB" && $PKG_MGR run build ); then
  echo "[deploy] 构建失败，已跳过部署，线上保持原版本。"
  exit 0
fi

cp "$WEB/dist/index.html" "$WEB/dist/404.html"   # SPA 深链回退
touch "$WEB/dist/.nojekyll"                      # 让 Pages 跳过 Jekyll 预构建

WORK="$(mktemp -d)" || { echo "[deploy] 无法创建临时目录，跳过部署。"; exit 0; }

# Git for Windows 下 mktemp 可能返回 POSIX 形式（/tmp/...），原生 git 无法识别；
# 转成 C:/... 混合形式，让 sh 与 git 都能正确处理。
if command -v cygpath >/dev/null 2>&1; then
  CONV="$(cygpath -m "$WORK" 2>/dev/null)"
  [ -n "$CONV" ] && WORK="$CONV"
fi

LABA_DEPLOY_ACTIVE=1
export LABA_DEPLOY_ACTIVE

cleanup() { rm -rf "$WORK" 2>/dev/null || true; }
trap cleanup EXIT INT TERM

if ! git -C "$WORK" init --quiet; then
  echo "[deploy] 临时仓库初始化失败，跳过部署。"
  exit 0
fi
git -C "$WORK" remote add origin "$REMOTE_URL" || { echo "[deploy] 配置远端失败，跳过部署。"; exit 0; }

if git -C "$WORK" fetch --no-tags --quiet origin gh-pages 2>/dev/null; then
  git -C "$WORK" checkout --quiet -B gh-pages FETCH_HEAD || { echo "[deploy] 检出 gh-pages 失败，跳过部署。"; exit 0; }
else
  # 拉取失败有两种可能：网络/凭据问题，或远端真的还没有 gh-pages 分支。
  # 必须区分 —— 若把网络故障当成"分支不存在"，就会基于空分支重建，
  # 产出一个无父提交（网络若随后恢复，push 会被拒；严重时会丢掉分支历史）。
  # ls-remote 的退出码：0 = 找到该分支，2 = 没有匹配的引用，其他 = 连不上。
  git -C "$WORK" ls-remote --exit-code --heads origin gh-pages >/dev/null 2>&1
  rc=$?
  if [ "$rc" = "2" ]; then
    git -C "$WORK" checkout --quiet -B gh-pages || { echo "[deploy] 创建 gh-pages 失败，跳过部署。"; exit 0; }
  else
    echo "[deploy] 无法获取远端 gh-pages（网络或凭据问题），已跳过部署，线上保持原版本。"
    exit 0
  fi
fi

# 用本次构建产物整体替换分支内容（保留 .git），产物位于分支根目录
find "$WORK" -mindepth 1 -maxdepth 1 ! -name .git -exec rm -rf {} + 2>/dev/null
cp -R "$WEB/dist/." "$WORK"/ || { echo "[deploy] 复制构建产物失败，跳过部署。"; exit 0; }

git -C "$WORK" add -A
if git -C "$WORK" diff --cached --quiet; then
  echo "[deploy] 构建产物与线上一致，无需更新。"
else
  SRC="$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
  if git -C "$WORK" \
      -c user.name="laba-deploy" \
      -c user.email="deploy@localhost" \
      commit --quiet -m "Deploy $SRC to GitHub Pages"; then
    if git -C "$WORK" push --quiet origin HEAD:gh-pages; then
      echo "[deploy] 已发布到 gh-pages，约 1 分钟后生效：https://jolaaa999.github.io/LABA/"
    else
      echo "[deploy] 推送 gh-pages 失败（网络或凭据问题），线上保持原版本。"
    fi
  else
    echo "[deploy] 提交失败，跳过部署。"
  fi
fi

exit 0
